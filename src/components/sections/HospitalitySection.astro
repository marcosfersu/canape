---
import HeroTextIcon from "@/assets/HeroTextIcon.astro";
import { getI18N } from "@/i18n/";
import Button from "../ui/Button.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div class="hospitality-wrapper relative w-full lg:absolute max-lg:h-[250vh]">
  <section class="hospitality-section absolute h-screen w-full inset-0 max-lg:sticky max-lg:top-0 max-lg:h-screen max-lg:inset-auto max-lg:overflow-hidden flex flex-col justify-between">
    <div class="hospitality-images lg:absolute max-lg:fixed max-lg:inset-0 max-lg:h-screen h-screen inset-0 z-0 flex justify-center items-center pointer-events-none">
      <ul class="flex justify-center gap-4 lg:mx-4 mx-0 h-96 lg:h-screen max-lg:h-[80vh] overflow-hidden lg:overflow-visible">
        <li class="shrink-0 w-auto max-lg:max-w-[100vw] lg:flex-1">
          <img class="w-full h-full object-cover" src="/images/3.webp" alt="" />
        </li>

        <li class="shrink-0 w-auto max-lg:max-w-[100vw] lg:flex-1">
          <img class="w-full h-full object-cover" src="/images/1.webp" alt="" />
        </li>

        <li class="shrink-0 w-auto max-lg:max-w-[100vw] lg:flex-1">
          <img class="w-full h-full object-cover" src="/images/4.webp" alt="" />
        </li>
      </ul>
    </div>

    <div class="hospitality-text absolute max-lg:absolute max-lg:inset-0 max-lg:h-screen inset-0 z-10 flex flex-col items-center justify-center text-center px-6 pointer-events-auto">
      <div class="max-w-2xl flex flex-col items-center justify-center">
        <HeroTextIcon className="size-12 mb-4" />

        <h2 class="lg:text-4xl text-3xl md:text-6xl font-bold mb-4 uppercase show-text">
          {i18n.HOSPITALITY.TITLE_2}
        </h2>

        <p class="lg:text-base text-sm opacity-80 mb-6 uppercase max-w-md m-auto show-text">
          {i18n.HOSPITALITY.DESCRIPTION}
        </p>
        <Button
          href="#service"
          class="inline-block font-altesse pb-1 text-2xl tracking-wider hover:opacity-75 transition-opacity show-text"
          dataOffset={7.5}
          mobileTarget=".service-text"
          mobileProgress={29}
          mobileDuration={30}
        >
          {i18n.HOSPITALITY.CTA}
        </Button>
      </div>
    </div>
  </section>
</div>
