---
import ArrowIcon from "@/assets/ArrowIcon.astro";
import Button from "../ui/Button.astro";
---

<div class="journal-wrapper relative w-full lg:absolute max-md:h-[100vh]">
  <section class="journal-section absolute h-screen w-full inset-0 max-md:sticky max-md:top-0 max-md:inset-auto max-md:h-screen">
    <div class="journal-text absolute inset-0 z-10 flex flex-col gap-26 items-center justify-center text-center px-6 pointer-events-auto">
      <div class="max-w-6xl flex flex-col items-center justify-center">
        <h2 class="lg:text-[12rem] leading-relaxed text-6xl md:text-8xl font-altesse font-light show-text">
          Canapé Journal
        </h2>
        <div class="max-w-md px-2 w-full">
          <p class="font-bold uppercase mb-5 show-text">
            Del concepto a la mesa
          </p>
          <p class="font-medium uppercase show-text">
            SUSCRIBITE A NUESTRO NEWSLETTER Y RECIBÍ LA MEJOR INFORMACIÓN
          </p>
        </div>
      </div>

      <div class="lg:max-w-lg px-10 w-full flex items-center gap-5 flex-col show-element">
        <input
          type="email"
          name="email"
          placeholder="TUMAIL@GMAIL.COM"
          required
          class="text-center placeholder:text-center text-xl w-full placeholder:text-custom-red focus:placeholder:text-custom-red/20 border-b focus:outline-none focus:shadow-[inset_0_-1px_0_0_var(--color-custom-red)]"
        />
        <Button>Suscribirme</Button>
        <ArrowIcon class="text-custom-red size-14 mt-10" />
      </div>
    </div>
  </section>
</div>
