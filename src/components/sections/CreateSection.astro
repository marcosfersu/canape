---
import ArrowIcon from "@/assets/ArrowIcon.astro";
import HeroTextIcon from "@/assets/HeroTextIcon.astro";
import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div class="create-wrapper relative w-full lg:absolute max-md:h-[300vh] overflow-x-clip">
  <section
    class="create-section absolute h-screen w-full inset-0
    max-md:sticky max-md:top-0 max-md:h-screen max-md:w-full max-md:inset-auto"
  >
    <div class="create-text absolute inset-0 z-10 flex flex-col items-center justify-center text-center px-6 pointer-events-auto">
      <div class="lg:max-w-4xl flex flex-col items-center justify-center">
        <h4 class="lg:text-2xl text-xs uppercase tracking-widest font-light mb-4 show-text">
          {i18n.CREATE.TITLE_1}
        </h4>

        <h2 class="lg:text-4xl text-3xl md:text-6xl font-bold mb-4 uppercase show-text">
          {i18n.CREATE.TITLE_2}
        </h2>

        <p class="lg:text-base text-sm opacity-80 mb-6 uppercase lg:px-2 show-text">
          {i18n.CREATE.DESCRIPTION}
        </p>
      </div>
      <ArrowIcon class="text-custom-red size-14 lg:mt-10" />
    </div>

    <div class="create-roles absolute inset-0 z-10 px-6 pointer-events-auto flex flex-col items-center justify-center overflow-hidden">
      <div class="flex flex-col items-center max-w-2xl w-full relative justify-center text-center">
        <h3
          class="lg:text-6xl text-2xl leading-40 lg:leading-normal px-2 md:text-5xl relative font-bold h-20 w-full max-w-2xl overflow-hidden uppercase flex flex-col items-center justify-center gap-10 [&_span]:absolute
        before:content-['('] after:content-[')'] after:absolute before:absolute after:right-0 before:left-0
        before:translate-x-(--pseudo-tx-before,-0.25rem)
        after:translate-x-(--pseudo-tx-after,0.25rem)
        before:opacity-(--pseudo-opacity,0) after:opacity-(--pseudo-opacity,0) transition-none"
        >
          {i18n.CREATE.ROLES.map((role) => (
            <span class="item-roles">{role}</span>
          ))}
        </h3>

        <HeroTextIcon className="lg:w-6 w-3 h-auto absolute lg:top-[40%] top-0 lg:-right-20 right-0 -translate-y-1/2 opacity-0 create-icon" />
      </div>
    </div>
  </section>
</div>
