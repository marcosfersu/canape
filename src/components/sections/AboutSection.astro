---
import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section class="about-section absolute h-screen w-full inset-0 flex items-center justify-center overflow-hidden">
  <div class="inset-0 z-10 flex flex-col items-center justify-center relative text-center max-w-2xl px-6 pointer-events-auto">
    <p class="about-head text-center text-xl max-w-md uppercase">
      {i18n.ABOUT.HEADING}
    </p>

    <h2 class="about-title-1 text-center font-altesse text-[12rem] leading-tight">
      EstebanBravo
    </h2>

    <div class="absolute -z-10 about-img">
      <img src="./EstebanBravo.png" class="max-h-[80vh] w-auto" alt="" />
    </div>
  </div>

  <div class="uppercase about-description absolute max-w-xl text-center flex flex-col gap-4">
    <h2 class="text-6xl font-semibold">{i18n.ABOUT.NAME}</h2>

    <h4 class="font-semibold">{i18n.ABOUT.ROLE}</h4>

    <div class="flex flex-col gap-4 text-justify">
      <p>{i18n.ABOUT.BIO_1}</p>
      <p>{i18n.ABOUT.BIO_2}</p>
      <p>{i18n.ABOUT.BIO_3}</p>
    </div>
  </div>
</section>
