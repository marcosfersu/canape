---
import Brand from "@/assets/Brand.astro";
import HeroText from "./HeroText.astro";
---

<div class="hero-wrapper relative w-full lg:absolute max-md:h-[300vh] bg-amber-400">
  <section
    class="hero-section
      relative h-screen w-full overflow-hidden
      max-md:sticky
      max-md:top-0
      max-md:h-screen"
  >
    <div class="hero-text absolute inset-0 z-10 flex items-center justify-center overflow-hidden">
      <HeroText />
    </div>

    <div class="logo absolute top-full left-1/2 w-full max-w-8xl -translate-x-1/2 px-30">
      <Brand className="w-full" />
    </div>

    <div class="hero-video pointer-events-none absolute inset-0 flex items-center justify-center max-w-5xl m-auto scale-90">
      <img src="/images/img-test-2.webp" alt="Test Image" />
    </div>
  </section>
</div>
