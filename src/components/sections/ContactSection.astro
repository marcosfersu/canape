---
import ArrowIcon from "@/assets/ArrowIcon.astro";
import Button from "../ui/Button.astro";

export const LinksShaders = [
  {
    name: "whatsapp",
    href: `https://wa.me/5493524410888?text=${encodeURIComponent("Hola, llegué desde la web de Canapé ✦ Tengo una idea dando vueltas y me gustaría contarles un poco más.")}`,
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    name: "mail",
    href: "mailto:tu-correo@example.com", // Para correos se usa mailto:
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    name: "instagram",
    href: "https://instagram.com/holacanape",
    target: "_blank",
    rel: "noopener noreferrer",
  },
];
---

<div class="contact-wrapper relative w-full lg:absolute max-lg:h-[250vh]">
  <section class="contact-section absolute h-screen w-full inset-0 max-lg:sticky max-lg:top-0 max-lg:h-screen max-lg:inset-auto max-lg:overflow-hidden">
    <div class="contact-images absolute max-lg:fixed max-lg:inset-0 max-lg:h-screen h-screen inset-0 z-0 flex justify-center items-center pointer-events-none">
      <ul class="flex justify-center gap-4 lg:mx-4 mx-0 h-96 lg:h-screen max-lg:h-[80vh] overflow-hidden lg:overflow-visible">
        <li class="shrink-0 w-auto lg:flex-1">
          <img
            class="w-full h-full object-cover"
            src="/images/contact-1.webp"
            alt=""
          />
        </li>

        <li class="shrink-0 w-auto lg:flex-1">
          <img
            class="w-full h-full object-cover"
            src="/images/contact-2.webp"
            alt=""
          />
        </li>

        <li class="shrink-0 w-auto lg:flex-1">
          <img
            class="w-full h-full object-cover"
            src="/images/contact-3.webp"
            alt=""
          />
        </li>
      </ul>
    </div>

    <div class="contact-text absolute max-lg:absolute max-lg:inset-0 max-lg:h-screen inset-0 z-10 flex flex-col gap-26 items-center justify-center text-center px-6 pointer-events-auto uppercase max-w-6xl m-auto text-4xl lg:text-9xl">
      <div class="relative">
        <h2 class="show-text">
          <span class="font-altesse capitalize w-full block lg:text-[13rem] text-8xl md:text-8xl show-text">
            Pasá
          </span>
          La puerta está abierta.
        </h2>

        <img
          src="/gifs/leo.gif"
          alt="Leo"
          class="w-32 h-auto absolute -z-10 lg:-bottom-16 left-1/2 -translate-x-1/2 show-element"
        />
      </div>
      <div class="flex flex-col items-center">
        <div class="flex lg:gap-20 gap-10 show-element max-lg:mt-10">
          {LinksShaders.map(({ name, href }) => (
            <Button href={href} blank class="lg:text-4xl">
              {name}
            </Button>
          ))}
        </div>
        <ArrowIcon class="text-custom-red size-14 mt-5 lg:mt-10" />
      </div>
    </div>
  </section>
</div>
