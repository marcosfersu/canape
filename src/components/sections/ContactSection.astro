---
import Button from "../ui/Button.astro";

const LinksShaders = ["whatsapp", "mail", "instagram"];
---

<div class="contact-wrapper relative w-full lg:absolute max-md:h-[300vh]">
  <section class="contact-section absolute h-screen w-full inset-0">
    <div class="contact-images absolute h-screen inset-0 z-0 flex justify-center items-center pointer-events-none">
      <ul class="flex gap-4 mx-4 h-[80vh]">
        <li class="flex-1">
          <img
            class="w-full h-full object-cover"
            src="/images/contact-1.webp"
            alt=""
          />
        </li>
        <li class="flex-1">
          <img
            class="w-full h-full object-cover"
            src="/images/contact-2.webp"
            alt=""
          />
        </li>
        <li class="flex-1">
          <img
            class="w-full h-full object-cover"
            src="/images/contact-3.webp"
            alt=""
          />
        </li>
      </ul>
    </div>
    <div class="absolute contact-text inset-0 z-10 flex flex-col gap-26 items-center justify-center text-center px-6 pointer-events-auto uppercase max-w-6xl m-auto text-xl lg:text-9xl">
      <div class="relative">
        <h2 class="show-text">
          <span class="font-altesse capitalize w-full block lg:text-[13rem] text-6xl md:text-8xl lg:leading-35 show-text">
            Pasá
          </span>
          La puerta está abierta.
        </h2>
        <img
          src="/gifs/leo.gif"
          alt="Leo"
          class="w-32 h-auto absolute -z-10 -bottom-16 left-1/2 -translate-x-1/2 show-element"
        />
      </div>
      <div class="flex lg:gap-20 gap-10 show-element">
        {LinksShaders.map((text) => (
          <Button class="lg:text-6xl">{text}</Button>
        ))}
      </div>
    </div>
  </section>
</div>
