---
import CreateSection from "@/components/sections/CreateSection.astro";
import Hero from "@/components/sections/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import HospitalitySection from "@/components/sections/HospitalitySection.astro";
import ServiceSection from "@/components/sections/ServiceSection.astro";
import AboutSection from "@/components/sections/AboutSection.astro";
import LoopSection from "@/components/sections/LoopSection.astro";
import GallerySection from "../sections/GallerySection.astro";
import JournalSection from "../sections/JournalSection.astro";
import ContactSection from "../sections/ContactSection.astro";
---

<Layout>
  <main class="home min-h-screen">
    <div class="home-animation">
      <Hero />
      <HospitalitySection />
      <CreateSection />
      <ServiceSection />
      <AboutSection />
      <GallerySection />
      <JournalSection />
      <ContactSection />
      <LoopSection />
    </div>
  </main>
</Layout>

<script>
  import { initHomeAnimations } from "@/libs/gsap/initHomeAnimations";

  const init = () => {
    initHomeAnimations();
  };

  init();

  document.addEventListener("astro:page-load", init);
</script>
