---
interface Props {
  href?: string;
  class?: string;
  dataOffset?: number;
  mobileTarget?: string;
  mobileProgress?: number;
  mobileDuration?: number;
  blank?: boolean;
}

const {
  href,
  class: className,
  dataOffset = 0,
  mobileTarget,
  mobileProgress = 0,
  mobileDuration = 30,
  blank = false,
} = Astro.props;
---

<a
  class:list={[
    "font-altesse animated-link text-2xl lowercase inline cursor-pointer",
    className,
  ]}
  data-offset={dataOffset}
  data-mobile-target={mobileTarget}
  data-mobile-progress={mobileProgress}
  data-mobile-duration={mobileDuration}
  href={href}
  target={`${blank} && "_blank"`}
  rel="noopener noreferrer"
>
  <slot />
</a>

<style>
  .animated-link {
    position: relative;
    text-decoration: none;
  }

  .animated-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-custom-red);
    transform: scaleX(1);
    transform-origin: left;
    transition:
      transform 0.3s ease,
      height 0.3s ease;
  }

  .animated-link:hover::after {
    transform: scaleX(0);
    transform-origin: right;
    height: 2px;
  }
</style>

<script>
  import { positions } from "../../libs/const/positions";
  import { scrollToSection } from "../../libs/gsap/scrollToSection";

  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();

      const section = link.getAttribute("href")?.replace("#", "");
      const offset = Number(link.getAttribute("data-offset") ?? 0);
      const mobileTarget = link.getAttribute("data-mobile-target") ?? undefined;

      const mobileProgress = Number(
        link.getAttribute("data-mobile-progress") ?? 0,
      );

      const mobileDuration = Number(
        link.getAttribute("data-mobile-duration") ?? 30,
      );

      if (section && section in positions) {
        scrollToSection(
          section as keyof typeof positions,
          offset,
          mobileTarget,
          mobileProgress,
          mobileDuration,
        );
      }
    });
  });
</script>
